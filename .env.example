# CasePilot LLM 配置模板：复制为 .env 并填入真实 key（.env 已 gitignore，严禁提交）
# 本文件只放占位符，不含任何真实密钥。

# API 密钥（也可用 OPENAI_API_KEY）
CASEPILOT_LLM_API_KEY=sk-你的key

# OpenAI 兼容接口地址（DeepSeek 示例；OpenAI 默认 https://api.openai.com/v1）
CASEPILOT_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek 可用 deepseek-flash / deepseek-v4-pro）
CASEPILOT_LLM_MODEL=deepseek-flash

# LLM 输出解析/校验失败自动重试次数（可选，默认 2）
# CASEPILOT_LLM_MAX_RETRIES=2
